<resources>
    <string name="app_name">Fildy</string>
    <!-- Language of these strings; used to format dates and numbers to match. -->
    <string name="locale_tag" translatable="false">es-AR</string>

    <!-- Home header, e.g. "Hola, Francisco" -->
    <string name="home_greeting">Hola, %s</string>

    <!-- Weather -->
    <string name="weather_temperature">%1$d°</string>
    <string name="weather_condition_clear">Despejado</string>
    <!-- e.g. "Dom 15 nov · 27° / 14°" (date, max, min) -->
    <string name="weather_date_range">%1$s · %2$d° / %3$d°</string>
    <string name="weather_humidity">Humedad</string>
    <string name="weather_rain">Lluvia</string>
    <string name="weather_wind">Viento</string>
    <string name="weather_percent">%1$d%%</string>
    <string name="weather_wind_unit">km/h</string>

    <!-- Voice -->
    <string name="voice_tap_to_talk">Tocá y hablá</string>
    <string name="voice_tap_to_finish">Tocá para terminar</string>
    <!-- While recording -->
    <string name="voice_prompt_title">Te escucho…</string>
    <string name="voice_prompt_hint">Contame qué pasó o preguntá algo.\nPor ejemplo: “¿Cuánto llovió este mes?”</string>
    <!-- Not recording, microphone allowed -->
    <string name="voice_ready_title">¿En qué te ayudo?</string>
    <string name="voice_ready_hint">Tocá el micrófono y contame qué pasó o preguntá algo.</string>
    <!-- Not recording, microphone not allowed yet -->
    <string name="voice_permission_title">Necesito tu permiso</string>
    <string name="voice_permission_hint">Para escucharte necesito usar el micrófono.\nTocá el botón para darme permiso.</string>
    <string name="voice_tap_to_allow">Tocá para dar permiso</string>
    <string name="voice_processing">Procesando…</string>
    <string name="voice_thinking">Pensando…</string>
    <string name="voice_wait">Un momento…</string>
    <string name="voice_error_generic">Algo salió mal. Probá de nuevo.</string>
    <string name="voice_error_too_short">Fue muy corto. Hablá un poco más antes de terminar.</string>
    <string name="voice_error_nothing_heard">No escuché nada. Probá de nuevo.</string>
    <string name="voice_error_permission">Necesito el micrófono para escucharte. También podés escribir.</string>
    <string name="voice_start_description">Empezar a hablar</string>
    <string name="voice_stop_description">Terminar de hablar</string>
    <string name="voice_keyboard_description">Escribir en vez de hablar</string>
    <string name="voice_close_description">Cerrar</string>

    <!-- Farm card -->
    <string name="farm_card_title">Mi campo</string>
    <plurals name="farm_card_paddocks">
        <item quantity="one">%d lote</item>
        <item quantity="other">%d lotes</item>
    </plurals>
    <!-- Abbreviation of "cabezas" (head of cattle), after the total -->
    <string name="farm_card_head_unit">cab.</string>
    <string name="cattle_cow">Vacas</string>
    <string name="cattle_heifer">Vaquillonas</string>
    <string name="cattle_calf">Terneros</string>
    <string name="cattle_steer">Novillos</string>
    <string name="cattle_bull">Toros</string>

    <!-- Rain card -->
    <string name="rain_card_title">Lluvia · %d días</string>
    <string name="rain_unit">mm</string>
    <string name="rain_card_none">Sin lluvias en este período</string>
    <string name="rain_card_last_today">Última: %s mm hoy</string>
    <string name="rain_card_last_yesterday">Última: %s mm anoche</string>
    <plurals name="rain_card_last_days_ago">
        <item quantity="one">Última: %1$s mm hace %2$d día</item>
        <item quantity="other">Última: %1$s mm hace %2$d días</item>
    </plurals>
    <!-- Answer cards (voice screen) -->
    <!-- e.g. "LLUVIA · DOM 15 NOV" (shown uppercase) -->
    <string name="answer_card_rain">Lluvia · %s</string>
    <!-- A period, e.g. "1 nov – 16 nov" -->
    <string name="answer_card_period">%1$s – %2$s</string>
    <string name="answer_card_rain_none">Sin lluvia registrada</string>
    <plurals name="answer_card_rainy_days">
        <item quantity="one">%d día con lluvia</item>
        <item quantity="other">%d días con lluvia</item>
    </plurals>
    <!-- Paddock herd card, e.g. "HACIENDA · LOTE 5" (shown uppercase) -->
    <string name="answer_card_herd">Hacienda · %s</string>
    <!-- Unit after a head count, e.g. "348 animales" -->
    <plurals name="answer_card_animals_unit">
        <item quantity="one">animal</item>
        <item quantity="other">animales</item>
    </plurals>
    <!-- Under a category count, e.g. "de 348 animales en el lote" -->
    <plurals name="answer_card_of_total">
        <item quantity="one">de %s animal en el lote</item>
        <item quantity="other">de %s animales en el lote</item>
    </plurals>
    <!-- Category nouns after a big number, e.g. "150 | vacas" -->
    <plurals name="cattle_noun_cow">
        <item quantity="one">vaca</item>
        <item quantity="other">vacas</item>
    </plurals>
    <plurals name="cattle_noun_heifer">
        <item quantity="one">vaquillona</item>
        <item quantity="other">vaquillonas</item>
    </plurals>
    <plurals name="cattle_noun_calf">
        <item quantity="one">ternero</item>
        <item quantity="other">terneros</item>
    </plurals>
    <plurals name="cattle_noun_steer">
        <item quantity="one">novillo</item>
        <item quantity="other">novillos</item>
    </plurals>
    <plurals name="cattle_noun_bull">
        <item quantity="one">toro</item>
        <item quantity="other">toros</item>
    </plurals>
    <!-- Rain receipt, e.g. "LLUVIA · REGISTRO" (shown uppercase) -->
    <string name="answer_card_rain_saved">Lluvia · Registro</string>
    <!-- e.g. "18 mm el dom 15 nov" (millimeters, day) -->
    <string name="answer_card_rain_saved_title">%1$s mm el %2$s</string>
    <!-- When the day already had rain, e.g. "Reemplaza los 12 mm anteriores" -->
    <string name="answer_card_rain_saved_replaced">Reemplaza los %s mm anteriores</string>
    <string name="answer_card_rain_saved_new">Ese día no tenía lluvia registrada</string>
    <!-- Herd adjustment receipt, e.g. "HACIENDA · AJUSTE" (shown uppercase) -->
    <string name="answer_card_herd_adjust">Hacienda · Ajuste</string>
    <!-- e.g. "Se agregaron 20 vacas al Lote 1" (count with category, paddock) -->
    <plurals name="answer_card_adjust_add">
        <item quantity="one">Se agregó %1$s al %2$s</item>
        <item quantity="other">Se agregaron %1$s al %2$s</item>
    </plurals>
    <!-- e.g. "Se sacaron 10 toros del Lote 8" -->
    <plurals name="answer_card_adjust_remove">
        <item quantity="one">Se sacó %1$s del %2$s</item>
        <item quantity="other">Se sacaron %1$s del %2$s</item>
    </plurals>
    <!-- e.g. "Vacas del Lote 3: ahora 155" (category, paddock, new total) -->
    <string name="answer_card_adjust_set">%1$s del %2$s: ahora %3$d</string>
    <!-- e.g. "Antes 150 → ahora 170" -->
    <string name="answer_card_adjust_counts">Antes %1$d → ahora %2$d</string>
    <!-- Herd move receipt, e.g. "HACIENDA · MOVIMIENTO" (shown uppercase) -->
    <string name="answer_card_herd_move">Hacienda · Movimiento</string>
    <!-- e.g. "30 vacas del Lote 1 al Lote 2" (count with category, from, to) -->
    <string name="answer_card_move">%1$s del %2$s al %3$s</string>
    <!-- e.g. "Ahora hay 120 en Lote 1 y 170 en Lote 2" -->
    <string name="answer_card_move_counts">Ahora hay %1$d en %2$s y %3$d en %4$s</string>
    <!-- e.g. "Guardado hoy · 19:48" -->
    <string name="answer_card_saved_at">Guardado hoy · %s</string>
    <plurals name="cattle_count_cow">
        <item quantity="one">%d vaca</item>
        <item quantity="other">%d vacas</item>
    </plurals>
    <plurals name="cattle_count_heifer">
        <item quantity="one">%d vaquillona</item>
        <item quantity="other">%d vaquillonas</item>
    </plurals>
    <plurals name="cattle_count_calf">
        <item quantity="one">%d ternero</item>
        <item quantity="other">%d terneros</item>
    </plurals>
    <plurals name="cattle_count_steer">
        <item quantity="one">%d novillo</item>
        <item quantity="other">%d novillos</item>
    </plurals>
    <plurals name="cattle_count_bull">
        <item quantity="one">%d toro</item>
        <item quantity="other">%d toros</item>
    </plurals>
    <string name="rain_card_chart_description">Gráfico de lluvia diaria de los últimos %d días</string>
</resources>
