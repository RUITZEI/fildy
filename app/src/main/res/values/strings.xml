    <string name="rain_card_last_yesterday">Última: %s mm anoche</string>
    <plurals name="rain_card_last_days_ago">
        <item quantity="one">Última: %1$s mm hace %2$d día</item>
        <item quantity="other">Última: %1$s mm hace %2$d días</item>
