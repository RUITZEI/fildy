    <string name="farm_card_head_unit">cab.</string>
    <string name="cattle_cow">Vacas</string>
    <string name="cattle_heifer">Vaquillonas</string>
    <string name="cattle_calf">Terneros</string>
    <string name="cattle_steer">Novillos</string>
    <string name="cattle_bull">Toros</string>

